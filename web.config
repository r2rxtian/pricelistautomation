<?xml version="1.0" encoding="UTF-8"?>
<!--
  LRN Price List Automation on IIS. IIS does not read Apache's .htaccess files, so this does what
  .htaccess (and the folder .htaccess files) do on XAMPP, the same way QRTS's web.config does.
-->
<configuration>
  <system.webServer>
    <!--
      The app's own 403 and 404 pages, run internally so the requested address stays in the address
      bar. "Auto" keeps the responses PHP marks as its own, e.g. the JSON 403/404 answers of api/.
    -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="403" subStatusCode="-1" />
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="403" subStatusCode="-1"
             path="/pricelistautomation/pages/403.php" responseMode="ExecuteURL" />
      <error statusCode="404" subStatusCode="-1"
             path="/pricelistautomation/pages/404.php" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Speed: compressed responses, and styles/scripts/images kept a week (the app's own files carry
         ?v= numbers, so a new version is still fetched at once). Same as .htaccess. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- No folder listings (Options -Indexes). -->
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- Internal folders are never served (each has "Require all denied" for Apache). -->
        <hiddenSegments>
          <add segment="authz" />
          <add segment="components" />
          <add segment="conn" />
          <add segment="rules" />
          <add segment="sql" />
        </hiddenSegments>
        <!-- Internal files are never served (the FilesMatch rule in .htaccess). -->
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
          <add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- storage/: only the product photos are served; sessions and data files are not (storage/.htaccess). -->
  <location path="storage">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="false">
            <add fileExtension=".jpg" allowed="true" />
            <add fileExtension=".jpeg" allowed="true" />
            <add fileExtension=".png" allowed="true" />
            <add fileExtension=".webp" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
